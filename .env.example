# Environment variables for StockControl WMS
# Copy this file to `.env` (and optionally `.env.local`) and fill in real values.
# Never commit real secrets.

# PostgreSQL connection string (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Secret used to sign JWTs
JWT_SECRET="generate-a-long-random-string"

# "development" | "production" | "test"
NODE_ENV="development"

# Optional: comma-separated allowed CORS origins.
# Used by next.config.js headers. Defaults to "*" when unset.
# CORS_ORIGINS="https://app.example.com"
