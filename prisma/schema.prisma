generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                    String        @id @default(uuid())
  email                                 String        @unique
  passwordHash                          String
  name                                  String
  role                                  Role
  isActive                              Boolean       @default(true)
  createdAt                             DateTime      @default(now())
  updatedAt                             DateTime      @updatedAt
  auditLogs                             AuditLog[]
  Receiving_Receiving_createdByIdToUser Receiving[]   @relation("Receiving_createdByIdToUser")
  Receiving_Receiving_postedByIdToUser  Receiving[]   @relation("Receiving_postedByIdToUser")
  ledgerEntries                         StockLedger[]
  stockAdjustments                     StockAdjustment[] @relation("AdjustmentCreator")
  approvedAdjustments                  StockAdjustment[] @relation("AdjustmentApprover")
  cycleCounts                          CycleCount[]  @relation("CycleCountCreator")
  assignedCycleCounts                  CycleCount[]  @relation("CycleCountAssignedTo")
  approvedCycleCounts                  CycleCount[]  @relation("CycleCountApprover")
  packingOrdersCreated                PackingOrder[] @relation("PackingCreatedBy")
  packingOrdersAssigned               PackingOrder[] @relation("PackingAssignedTo")
  shipmentsCreated                   Shipment[]    @relation("ShipmentCreatedBy")
  shipmentsAssigned                  Shipment[]    @relation("ShipmentAssignedTo")
  shipmentPackagesVerified            ShipmentPackage[] @relation("ShipmentPackageVerifiedBy")
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  items       Item[]
}

model Uom {
  id    String @id @default(uuid())
  code  String @unique
  name  String
  items Item[]
}

model Item {
  id             String          @id @default(uuid())
  sku            String          @unique
  name           String
  description    String?
  barcode        String?
  categoryId     String
  uomId          String
  minStock       Float           @default(0)
  maxStock       Float           @default(0)
  reorderPoint   Float           @default(0)
  unitCost       Float           @default(0)
  imageUrl       String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  serialTracked  Boolean         @default(false)
  fifoLayers     FifoLayer[]
  category       Category        @relation(fields: [categoryId], references: [id])
  uom            Uom             @relation(fields: [uomId], references: [id])
  putawayTasks   PutawayTask[]
  receivingLines ReceivingLine[]
  serials        SerialNumber[]
  ledgerEntries  StockLedger[]
  stockAdjustmentLines StockAdjustmentLine[]
  cycleCountLines    CycleCountLine[]
  pickingOrderLines  PickingOrderLine[]
  packageItems       PackageItem[]

  @@index([sku])
  @@index([name])
  @@index([barcode])
}

model Warehouse {
  id         String      @id @default(uuid())
  code       String      @unique
  name       String
  address    String?
  isActive   Boolean     @default(true)
  receivings Receiving[]
  zones      Zone[]
}

model Zone {
  id          String     @id @default(uuid())
  warehouseId String
  code        String
  name        String
  locations   Location[]
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, code])
}

model Location {
  id                String         @id @default(uuid())
  zoneId            String
  code              String         @unique
  name              String         @default("")
  type              LocationType   @default(STORAGE)
  isActive          Boolean        @default(true)
  fifoLayers        FifoLayer[]
  zone              Zone           @relation(fields: [zoneId], references: [id])
  putawayTasksFrom  PutawayTask[]  @relation("PutawayFrom")
  putawayTasksTo    PutawayTask[]  @relation("PutawayTo")
  receivingsStaging Receiving[]    @relation("ReceivingStaging")
  serials           SerialNumber[]
  ledgerEntries     StockLedger[]
  stockAdjustmentLines StockAdjustmentLine[]
  cycleCountLines    CycleCountLine[]
  pickingTasks       PickingTask[]
}

model ReasonCode {
  id            String        @id @default(uuid())
  code          String        @unique
  description   String
  type          ReasonType
  isActive      Boolean       @default(true)
  ledgerEntries StockLedger[]
  stockAdjustmentLines StockAdjustmentLine[]
  stockAdjustments StockAdjustment[]
}

model StockLedger {
  id           String      @id @default(uuid())
  itemId       String
  locationId   String
  txnType      TxnType
  qty          Float
  unitCost     Float       @default(0)
  refType      String?
  refId        String?
  refNumber    String?
  reasonCodeId String?
  remarks      String?
  userId       String
  createdAt    DateTime    @default(now())
  item         Item        @relation(fields: [itemId], references: [id])
  location     Location    @relation(fields: [locationId], references: [id])
  reasonCode   ReasonCode? @relation(fields: [reasonCodeId], references: [id])
  user         User        @relation(fields: [userId], references: [id])

  @@index([itemId, locationId])
  @@index([createdAt])
  @@index([txnType])
}

model FifoLayer {
  id           String   @id @default(uuid())
  itemId       String
  locationId   String
  refNumber    String?
  receivedAt   DateTime @default(now())
  qtyReceived  Float
  qtyRemaining Float
  unitCost     Float    @default(0)
  createdAt    DateTime @default(now())
  item         Item     @relation(fields: [itemId], references: [id])
  location     Location @relation(fields: [locationId], references: [id])

  @@index([itemId, locationId, receivedAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  userName    String
  action      String
  module      String
  entityType  String
  entityId    String?
  description String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([module])
  @@index([createdAt])
  @@index([userId])
}

model Receiving {
  id                               String          @id @default(uuid())
  grnNumber                        String          @unique
  supplier                         String?
  refDocument                      String?
  remarks                          String?
  createdById                      String
  postedAt                         DateTime?
  createdAt                        DateTime        @default(now())
  updatedAt                        DateTime        @updatedAt
  cancelledAt                      DateTime?
  completedAt                      DateTime?
  postedById                       String?
  stagingLocationId                String
  warehouseId                      String
  status                           ReceivingStatus @default(DRAFT)
  startedAt                        DateTime?
  User_Receiving_createdByIdToUser User            @relation("Receiving_createdByIdToUser", fields: [createdById], references: [id])
  User_Receiving_postedByIdToUser  User?           @relation("Receiving_postedByIdToUser", fields: [postedById], references: [id])
  stagingLocation                  Location        @relation("ReceivingStaging", fields: [stagingLocationId], references: [id])
  warehouse                        Warehouse       @relation(fields: [warehouseId], references: [id])
  lines                            ReceivingLine[]

  @@index([status])
  @@index([warehouseId])
  @@index([createdAt])
}

model ReceivingLine {
  id           String         @id @default(uuid())
  receivingId  String
  itemId       String
  expectedQty  Float          @default(0)
  receivedQty  Float          @default(0)
  unitCost     Float          @default(0)
  batchNo      String?
  remarks      String?
  putawayTasks PutawayTask[]
  item         Item           @relation(fields: [itemId], references: [id])
  receiving    Receiving      @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  serials      SerialNumber[]

  @@index([receivingId])
  @@index([itemId])
}

model SerialNumber {
  id                String         @id @default(uuid())
  serialNo          String         @unique
  itemId            String
  receivingLineId   String?
  currentLocationId String?
  status            SerialStatus   @default(IN_STAGING)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  currentLocation   Location?      @relation(fields: [currentLocationId], references: [id])
  item              Item           @relation(fields: [itemId], references: [id])
  receivingLine     ReceivingLine? @relation(fields: [receivingLineId], references: [id])

  @@index([itemId])
  @@index([status])
}

model PutawayTask {
  id              String            @id @default(uuid())
  taskNumber      String            @unique
  itemId          String
  qty             Float
  fromLocationId  String
  toLocationId    String?
  remarks         String?
  createdById     String
  completedById   String?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  assignedToId    String?
  receivingId     String?
  receivingLineId String?
  startedAt       DateTime?
  updatedAt       DateTime          @updatedAt
  status          PutawayTaskStatus @default(OPEN)
  fromLocation    Location          @relation("PutawayFrom", fields: [fromLocationId], references: [id])
  item            Item              @relation(fields: [itemId], references: [id])
  receivingLine   ReceivingLine?    @relation(fields: [receivingLineId], references: [id])
  toLocation      Location?         @relation("PutawayTo", fields: [toLocationId], references: [id])

  @@index([status])
  @@index([receivingId])
}

model DocumentSequence {
  id            String   @id @default(uuid())
  prefix        String
  warehouseCode String
  yearMonth     String
  lastSeq       Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([prefix, warehouseCode, yearMonth])
  @@index([prefix])
}

model StockTransfer {
  id             String              @id @default(uuid())
  transferNumber String              @unique
  status         DocStatus           @default(DRAFT)
  remarks        String?
  reasonCodeId   String?
  createdById    String
  approvedById   String?
  approvedAt     DateTime?
  postedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  lines          StockTransferLine[]
}

model StockTransferLine {
  id             String        @id @default(uuid())
  transferId     String
  itemId         String
  fromLocationId String
  toLocationId   String
  qty            Float
  transfer       StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

model StockAdjustment {
  id               String                @id @default(uuid())
  adjustmentNumber String                @unique
  status           DocStatus             @default(DRAFT)
  reasonCodeId     String?
  remarks          String?
  createdById      String
  approvedById     String?
  approvedAt       DateTime?
  postedAt         DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  lines            StockAdjustmentLine[]
  createdBy        User                  @relation("AdjustmentCreator", fields: [createdById], references: [id])
  approvedBy       User?                 @relation("AdjustmentApprover", fields: [approvedById], references: [id])
  reasonCode       ReasonCode?           @relation(fields: [reasonCodeId], references: [id])
}

model StockAdjustmentLine {
  id            String          @id @default(uuid())
  adjustmentId  String
  itemId        String
  locationId    String
  qty           Float           @default(0)
  systemQty     Float           @default(0)
  countedQty    Float           @default(0)
  diffQty       Float           @default(0)
  reasonCodeId  String?
  remarks       String?
  adjustment    StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  item          Item            @relation(fields: [itemId], references: [id])
  location      Location        @relation(fields: [locationId], references: [id])
  reasonCode    ReasonCode?     @relation(fields: [reasonCodeId], references: [id])
}

model CycleCount {
  id           String           @id @default(uuid())
  countNumber  String           @unique
  status       DocStatus        @default(DRAFT)
  locationId   String?
  assignedToId String?
  remarks      String?
  createdById  String
  approvedById String?
  postedAt     DateTime?
  approvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  lines        CycleCountLine[]
  createdBy    User             @relation("CycleCountCreator", fields: [createdById], references: [id])
  assignedTo   User?           @relation("CycleCountAssignedTo", fields: [assignedToId], references: [id])
  approvedBy   User?           @relation("CycleCountApprover", fields: [approvedById], references: [id])
}

model PickingOrder {
  id              String             @id @default(uuid())
  pickingNumber   String             @unique
  status          PickingOrderStatus @default(DRAFT)
  priority        PickingPriority    @default(NORMAL)
  warehouseId     String?
  assignedToId    String?
  createdById     String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  startedAt       DateTime?
  completedAt     DateTime?
  notes           String?
  lines           PickingOrderLine[]
  packingOrder    PackingOrder?

  @@index([status])
  @@index([warehouseId])
  @@index([createdAt])
}

model PickingOrderLine {
  id             String            @id @default(uuid())
  pickingOrderId String
  itemId         String
  qtyOrdered     Float
  qtyPicked      Float            @default(0)
  status         PickingTaskStatus @default(OPEN)
  remarks        String?
  pickingOrder   PickingOrder     @relation(fields: [pickingOrderId], references: [id], onDelete: Cascade)
  item           Item             @relation(fields: [itemId], references: [id])
  tasks          PickingTask[]

  @@index([pickingOrderId])
  @@index([itemId])
}

model PickingTask {
  id             String            @id @default(uuid())
  pickingLineId  String
  locationId     String
  fifoLayerId    String?
  sequence       Int               @default(0)
  qty            Float
  qtyPicked      Float            @default(0)
  status         PickingTaskStatus @default(OPEN)
  pickedById     String?
  pickedAt       DateTime?
  startedAt      DateTime?
  createdAt      DateTime          @default(now())
  pickingLine    PickingOrderLine  @relation(fields: [pickingLineId], references: [id], onDelete: Cascade)
  location       Location          @relation(fields: [locationId], references: [id])

  serials           PickingTaskSerial[]
  packageAllocations PackageAllocation[]

  @@index([pickingLineId])
  @@index([status])
  @@index([locationId])
}

model PickingTaskSerial {
  id            String     @id @default(uuid())
  pickingTaskId String
  serialNo      String
  pickedAt      DateTime  @default(now())
  packageId     String?
  pickingTask   PickingTask @relation(fields: [pickingTaskId], references: [id], onDelete: Cascade)
  package       Package?    @relation(fields: [packageId], references: [id])

  @@unique([pickingTaskId, serialNo])
  @@index([pickingTaskId])
  @@index([packageId])
}

enum PackingOrderStatus {
  QUEUE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PackageStatus {
  OPEN
  CLOSED
}

model PackingOrder {
  id              String             @id @default(uuid())
  packingNumber   String             @unique
  status          PackingOrderStatus @default(QUEUE)
  pickingOrderId  String?            @unique
  warehouseId     String?
  assignedToId    String?
  createdById     String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  startedAt       DateTime?
  completedAt     DateTime?
  pickingOrder    PickingOrder?      @relation(fields: [pickingOrderId], references: [id])
  packages        Package[]
  assignedTo      User?              @relation("PackingAssignedTo", fields: [assignedToId], references: [id])
  createdBy       User?              @relation("PackingCreatedBy", fields: [createdById], references: [id])
  shipments       Shipment[]

  @@index([status])
  @@index([pickingOrderId])
  @@index([warehouseId])
}

model Package {
  id            String        @id @default(uuid())
  packageNumber String        @unique
  packingOrderId String
  status        PackageStatus @default(OPEN)
  weight        Float?
  length        Float?
  width         Float?
  height        Float?
  volume        Float?
  createdAt     DateTime      @default(now())
  closedAt      DateTime?
  packingOrder  PackingOrder  @relation(fields: [packingOrderId], references: [id], onDelete: Cascade)
  items         PackageItem[]
  serials       PickingTaskSerial[]

  @@index([packingOrderId])
  @@index([status])
}

model PackageItem {
  id         String        @id @default(uuid())
  packageId  String
  itemId     String
  qty        Float
  package    Package       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  item       Item          @relation(fields: [itemId], references: [id])
  allocations PackageAllocation[]

  @@unique([packageId, itemId])
  @@index([packageId])
  @@index([itemId])
}

model PackageAllocation {
  id            String       @id @default(uuid())
  packageItemId String
  pickingTaskId String
  qtyPacked    Float
  packageItem  PackageItem  @relation(fields: [packageItemId], references: [id], onDelete: Cascade)
  pickingTask  PickingTask  @relation(fields: [pickingTaskId], references: [id], onDelete: Cascade)

  @@unique([packageItemId, pickingTaskId])
  @@index([pickingTaskId])
}

model CycleCountLine {
  id           String     @id @default(uuid())
  cycleCountId String
  itemId       String
  locationId   String
  systemQty    Float      @default(0)
  countedQty   Float      @default(0)
  diffQty      Float      @default(0)
  cycleCount   CycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  item         Item       @relation(fields: [itemId], references: [id])
  location     Location   @relation(fields: [locationId], references: [id])
}

model StockOpname {
  id           String            @id @default(uuid())
  opnameNumber String            @unique
  status       DocStatus         @default(DRAFT)
  remarks      String?
  createdById  String
  approvedById String?
  postedAt     DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  lines        StockOpnameLine[]
}

model StockOpnameLine {
  id            String      @id @default(uuid())
  stockOpnameId String
  itemId        String
  locationId    String
  systemQty     Float       @default(0)
  countedQty    Float       @default(0)
  diffQty       Float       @default(0)
  stockOpname   StockOpname @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)
}

model Shipment {
  id               String              @id @default(uuid())
  shipmentNumber   String             @unique
  status           ShipmentStatus   @default(QUEUE)
  warehouseId      String?
  packingOrderId   String?           @unique
  createdById      String
  assignedToId     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  startedAt        DateTime?
  completedAt      DateTime?
  shippedAt        DateTime?
  packages         ShipmentPackage[]
  createdBy        User             @relation("ShipmentCreatedBy", fields: [createdById], references: [id])
  assignedTo       User?            @relation("ShipmentAssignedTo", fields: [assignedToId], references: [id])
  packingOrder     PackingOrder?    @relation(fields: [packingOrderId], references: [id])

  @@index([status])
  @@index([createdAt])
}

model ShipmentPackage {
  id            String                   @id @default(uuid())
  shipmentId    String
  packageId     String
  status        ShipmentPackageStatus  @default(PENDING)
  scannedAt     DateTime               @default(now())
  verifiedAt    DateTime?
  verifiedById  String?
  shipment      Shipment             @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  verifiedBy    User?                 @relation("ShipmentPackageVerifiedBy", fields: [verifiedById], references: [id])

  @@unique([shipmentId, packageId])
  @@unique([packageId])
  @@index([shipmentId])
  @@index([packageId])
}

enum ShipmentStatus {
  QUEUE
  IN_PROGRESS
  READY
  COMPLETED
  FAILED
  CANCELLED
}

enum ShipmentPackageStatus {
  PENDING
  VERIFIED
  CONFIRMED
  FAILED
}

enum Role {
  ADMINISTRATOR
  STOCK_CONTROL
  SUPERVISOR
}

enum PickingOrderStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PickingPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PickingTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum LocationType {
  RECEIVING
  STORAGE
  PICKING
  STAGING
  DAMAGED
}

enum TxnType {
  RECEIVING
  PUTAWAY
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  CYCLE_COUNT
  OPNAME
  SHIP_OUT
}

enum ReceivingStatus {
  DRAFT
  RECEIVING
  WAITING_PUTAWAY
  COMPLETED
  CANCELLED
}

enum PutawayTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SerialStatus {
  IN_STAGING
  IN_STOCK
  ISSUED
  DAMAGED
}

enum DocStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
}

enum ReasonType {
  RECEIVING
  PUTAWAY
  MOVEMENT
  ADJUSTMENT
  CYCLE_COUNT
  OPNAME
}
