generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  STOCK_CONTROL
  SUPERVISOR
}

enum LocationType {
  RECEIVING
  STORAGE
  PICKING
  STAGING
  DAMAGED
}

enum TxnType {
  RECEIVING
  PUTAWAY
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  CYCLE_COUNT
  OPNAME
}

enum ReceivingStatus {
  DRAFT
  RECEIVING
  WAITING_PUTAWAY
  COMPLETED
  CANCELLED
}

enum PutawayTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SerialStatus {
  IN_STAGING
  IN_STOCK
  ISSUED
  DAMAGED
}

enum DocStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ReasonType {
  RECEIVING
  PUTAWAY
  MOVEMENT
  ADJUSTMENT
  CYCLE_COUNT
  OPNAME
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String
  name          String
  role          Role
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  auditLogs     AuditLog[]
  ledgerEntries StockLedger[]
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  items       Item[]
}

model Uom {
  id    String @id @default(uuid())
  code  String @unique
  name  String
  items Item[]
}

model Item {
  id             String          @id @default(uuid())
  sku            String          @unique
  name           String
  description    String?
  barcode        String?
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  uomId          String
  uom            Uom             @relation(fields: [uomId], references: [id])
  minStock       Float           @default(0)
  maxStock       Float           @default(0)
  reorderPoint   Float           @default(0)
  unitCost       Float           @default(0)
  imageUrl       String?
  serialTracked  Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  ledgerEntries  StockLedger[]
  fifoLayers     FifoLayer[]
  serials        SerialNumber[]
  receivingLines ReceivingLine[]
  putawayTasks   PutawayTask[]

  @@index([sku])
  @@index([name])
  @@index([barcode])
}

model Warehouse {
  id         String      @id @default(uuid())
  code       String      @unique
  name       String
  address    String?
  isActive   Boolean     @default(true)
  zones      Zone[]
  receivings Receiving[]
}

model Zone {
  id          String     @id @default(uuid())
  warehouseId String
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id])
  code        String
  name        String
  locations   Location[]

  @@unique([warehouseId, code])
}

model Location {
  id                String         @id @default(uuid())
  zoneId            String
  zone              Zone           @relation(fields: [zoneId], references: [id])
  code              String         @unique
  type              LocationType   @default(STORAGE)
  isActive          Boolean        @default(true)
  ledgerEntries     StockLedger[]
  fifoLayers        FifoLayer[]
  serials           SerialNumber[]
  putawayTasksFrom  PutawayTask[]  @relation("PutawayFrom")
  putawayTasksTo    PutawayTask[]  @relation("PutawayTo")
  receivingsStaging Receiving[]    @relation("ReceivingStaging")
}

model ReasonCode {
  id            String        @id @default(uuid())
  code          String        @unique
  description   String
  type          ReasonType
  isActive      Boolean       @default(true)
  ledgerEntries StockLedger[]
}

// ============ STOCK LEDGER - single source of truth ============
model StockLedger {
  id           String      @id @default(uuid())
  itemId       String
  item         Item        @relation(fields: [itemId], references: [id])
  locationId   String
  location     Location    @relation(fields: [locationId], references: [id])
  txnType      TxnType
  qty          Float // signed: positive = in, negative = out
  unitCost     Float       @default(0)
  refType      String? // RECEIVING | PUTAWAY | TRANSFER | ADJUSTMENT | CYCLE_COUNT | OPNAME | SEED
  refId        String?
  refNumber    String?
  reasonCodeId String?
  reasonCode   ReasonCode? @relation(fields: [reasonCodeId], references: [id])
  remarks      String?
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  createdAt    DateTime    @default(now())

  @@index([itemId, locationId])
  @@index([createdAt])
  @@index([txnType])
}

// ============ FIFO ENGINE ============
model FifoLayer {
  id           String   @id @default(uuid())
  itemId       String
  item         Item     @relation(fields: [itemId], references: [id])
  locationId   String
  location     Location @relation(fields: [locationId], references: [id])
  refNumber    String?
  receivedAt   DateTime @default(now())
  qtyReceived  Float
  qtyRemaining Float
  unitCost     Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([itemId, locationId, receivedAt])
}

// ============ AUDIT TRAIL ============
model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  userName    String
  action      String // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | APPROVE | REJECT | POST
  module      String // AUTH | MASTER_ITEM | LOCATION | RECEIVING | PUTAWAY | MOVEMENT | ADJUSTMENT | CYCLE_COUNT | OPNAME
  entityType  String
  entityId    String?
  description String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([module])
  @@index([createdAt])
  @@index([userId])
}

// ============ PRIORITY 2+ TRANSACTION DOCUMENTS ============
model Receiving {
  id                String          @id @default(uuid())
  grnNumber         String          @unique
  warehouseId       String
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id])
  stagingLocationId String
  stagingLocation   Location        @relation("ReceivingStaging", fields: [stagingLocationId], references: [id])
  supplier          String?
  refDocument       String?
  status            ReceivingStatus @default(DRAFT)
  remarks           String?
  createdById       String
  postedById        String?
  postedAt          DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  lines             ReceivingLine[]

  @@index([status])
  @@index([warehouseId])
  @@index([createdAt])
}

model ReceivingLine {
  id           String         @id @default(uuid())
  receivingId  String
  receiving    Receiving      @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item           @relation(fields: [itemId], references: [id])
  expectedQty  Float          @default(0)
  receivedQty  Float          @default(0)
  unitCost     Float          @default(0)
  batchNo      String?
  remarks      String?
  serials      SerialNumber[]
  putawayTasks PutawayTask[]

  @@index([receivingId])
  @@index([itemId])
}

model SerialNumber {
  id                String         @id @default(uuid())
  serialNo          String         @unique
  itemId            String
  item              Item           @relation(fields: [itemId], references: [id])
  receivingLineId   String?
  receivingLine     ReceivingLine? @relation(fields: [receivingLineId], references: [id])
  currentLocationId String?
  currentLocation   Location?      @relation(fields: [currentLocationId], references: [id])
  status            SerialStatus   @default(IN_STAGING)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([itemId])
  @@index([status])
}

model PutawayTask {
  id              String            @id @default(uuid())
  taskNumber      String            @unique
  receivingId     String?
  receivingLineId String?
  receivingLine   ReceivingLine?    @relation(fields: [receivingLineId], references: [id])
  itemId          String
  item            Item              @relation(fields: [itemId], references: [id])
  qty             Float
  fromLocationId  String
  fromLocation    Location          @relation("PutawayFrom", fields: [fromLocationId], references: [id])
  toLocationId    String?
  toLocation      Location?         @relation("PutawayTo", fields: [toLocationId], references: [id])
  status          PutawayTaskStatus @default(OPEN)
  remarks         String?
  createdById     String
  assignedToId    String?
  completedById   String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([receivingId])
}

// ============ DOCUMENT NUMBERING (reusable for all modules) ============
model DocumentSequence {
  id            String   @id @default(uuid())
  prefix        String // GRN, PUT, MOV, ADJ, CC, SO
  warehouseCode String
  yearMonth     String // e.g. 202607
  lastSeq       Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([prefix, warehouseCode, yearMonth])
  @@index([prefix])
}

model StockTransfer {
  id             String              @id @default(uuid())
  transferNumber String              @unique
  status         DocStatus           @default(DRAFT)
  remarks        String?
  reasonCodeId   String?
  createdById    String
  approvedById   String?
  approvedAt     DateTime?
  postedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  lines          StockTransferLine[]
}

model StockTransferLine {
  id             String        @id @default(uuid())
  transferId     String
  transfer       StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemId         String
  fromLocationId String
  toLocationId   String
  qty            Float
}

model StockAdjustment {
  id               String                @id @default(uuid())
  adjustmentNumber String                @unique
  status           DocStatus             @default(DRAFT)
  reasonCodeId     String?
  remarks          String?
  createdById      String
  approvedById     String?
  approvedAt       DateTime?
  postedAt         DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  lines            StockAdjustmentLine[]
}

model StockAdjustmentLine {
  id           String          @id @default(uuid())
  adjustmentId String
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  itemId       String
  locationId   String
  systemQty    Float           @default(0)
  countedQty   Float           @default(0)
  diffQty      Float           @default(0)
}

model CycleCount {
  id          String           @id @default(uuid())
  countNumber String           @unique
  status      DocStatus        @default(DRAFT)
  locationId  String?
  remarks     String?
  createdById String
  postedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  lines       CycleCountLine[]
}

model CycleCountLine {
  id           String     @id @default(uuid())
  cycleCountId String
  cycleCount   CycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  itemId       String
  locationId   String
  systemQty    Float      @default(0)
  countedQty   Float      @default(0)
  diffQty      Float      @default(0)
}

model StockOpname {
  id           String            @id @default(uuid())
  opnameNumber String            @unique
  status       DocStatus         @default(DRAFT)
  remarks      String?
  createdById  String
  approvedById String?
  postedAt     DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  lines        StockOpnameLine[]
}

model StockOpnameLine {
  id            String      @id @default(uuid())
  stockOpnameId String
  stockOpname   StockOpname @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)
  itemId        String
  locationId    String
  systemQty     Float       @default(0)
  countedQty    Float       @default(0)
  diffQty       Float       @default(0)
}
